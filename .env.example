# Copy to backend/.env and replace placeholders with your own values.
# Chat/vision API keys can also be managed in the web UI ("模型与 API Key").
# The DashScope key below is only used to seed the first provider and for PDF embeddings.
DASHSCOPE_API_KEY=replace-me
TAVILY_API_KEY=replace-me
# Optional: improves Semantic Scholar request rate limits
SEMANTIC_SCHOLAR_API_KEY=
# Optional: identifies Crossref requests for its polite pool
CROSSREF_MAILTO=
APP_PASSWORD_HASH=replace-me
APP_SECRET_KEY=replace-me
APP_COOKIE_SECURE=false

# Agent safety limits · 问答档（紧凑，够用就快）
AGENT_MODEL=qwen-plus
AGENT_VISION_MODEL=qwen3-vl-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_MAX_ROUNDS=5
AGENT_MAX_TOOL_CALLS_PER_ROUND=3
AGENT_TOTAL_TIMEOUT=60
AGENT_LLM_TIMEOUT=30
AGENT_MAX_CONTEXT_CHARS=24000
AGENT_MAX_TOKENS_PER_RUN=12000
AGENT_MAX_OUTPUT_TOKENS=1800

# 改代码档：勾选「允许改代码」时自动启用，不走上面那套。
# 读文件 → 改一处 → 核对 diff → 再返工，5 轮走不完一个来回，所以单独放宽。
# 只在代码里留上界，环境变量在这里面随便调。
AGENT_CODE_MAX_ROUNDS=20
AGENT_CODE_MAX_TOOL_CALLS_PER_ROUND=6
AGENT_CODE_TOTAL_TIMEOUT=300
AGENT_CODE_LLM_TIMEOUT=60
AGENT_CODE_MAX_CONTEXT_CHARS=60000
# 按每次模型调用的 prompt+completion 累加计算，上下文越滚越大：
# 一次 15 轮的多文件重构实测约 9 万，60000 会在中途截断。
AGENT_CODE_MAX_TOKENS_PER_RUN=120000

# 需要确认的命令等多久（秒）。超时按拒绝处理；等待期间点「停止」会立刻放弃。
AGENT_APPROVAL_TIMEOUT=120

# 工作区只读工具（list_dir / read_file / grep_code）允许访问的根目录。
# 留空时默认使用项目根目录。路径限制在该目录内，且配置/数据库/密钥/依赖目录一律不可读。
# 只读工具本身默认不启用，需要前端勾选「允许读代码」。
AGENT_WORKSPACE=
