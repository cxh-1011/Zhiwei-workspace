# Copy to backend/.env and replace placeholders with your own values.
DASHSCOPE_API_KEY=replace-me
TAVILY_API_KEY=replace-me
# Optional: improves Semantic Scholar request rate limits
SEMANTIC_SCHOLAR_API_KEY=
# Optional: identifies Crossref requests for its polite pool
CROSSREF_MAILTO=
APP_PASSWORD_HASH=replace-me
APP_SECRET_KEY=replace-me
APP_COOKIE_SECURE=false

# Agent safety limits
AGENT_MODEL=qwen-plus
AGENT_VISION_MODEL=qwen3-vl-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_MAX_ROUNDS=5
AGENT_MAX_TOOL_CALLS_PER_ROUND=3
AGENT_TOTAL_TIMEOUT=60
AGENT_MAX_CONTEXT_CHARS=24000
AGENT_MAX_TOKENS_PER_RUN=12000
AGENT_MAX_OUTPUT_TOKENS=1800

# 工作区只读工具（list_dir / read_file / grep_code）允许访问的根目录。
# 留空时默认使用项目根目录。路径限制在该目录内，且配置/数据库/密钥/依赖目录一律不可读。
# 只读工具本身默认不启用，需要前端勾选「允许读代码」。
AGENT_WORKSPACE=
